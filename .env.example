# ─── ProjectsByAxy — Environment Variables ───────────────────────────
# Copy this to .env and fill in your values.

# ─── Supabase (required) ─────────────────────────────────────────────
# Get from: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...your-anon-key-here

# ─── Resend (Phase 3 — email notifications) ─────────────────────────
# Get your free API key at: resend.com → API Keys
# Set as Supabase SECRET (not in .env) via:
#   npx supabase secrets set RESEND_API_KEY=re_xxxx
#   npx supabase secrets set NOTIFY_EMAIL=mail@projectsbyaxy.com
#   npx supabase secrets set SITE_URL=https://projectsbyaxy.com

